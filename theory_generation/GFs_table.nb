Cell[BoxData[{
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"M", ">", "0"}], ",", 
     RowBox[{"a", ">", " ", "0"}], ",", 
     RowBox[{"r", ">", "0"}], ",", 
     RowBox[{"a", "<", "M"}], ",", 
     RowBox[{"\[Omega]", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]", "[", "r_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["r", "2"], "+", 
    SuperscriptBox["a", "2"], "-", 
    RowBox[{"2", " ", "M", " ", "r"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rplus", "=", 
   RowBox[{"M", "+", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["M", "2"], "-", 
      SuperscriptBox["a", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rminus", "=", 
   RowBox[{"M", "-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["M", "2"], "-", 
      SuperscriptBox["a", "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalOmega]h", "=", 
   FractionBox["a", 
    RowBox[{
     SuperscriptBox["rplus", "2"], "+", 
     SuperscriptBox["a", "2"]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "r_", "]"}], ":=", 
   FractionBox[
    RowBox[{"\[CapitalDelta]", "[", "r", "]"}], 
    RowBox[{
     SuperscriptBox["r", "2"], "+", 
     SuperscriptBox["a", "2"]}]]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"7512b578-9816-46c7-bd8d-2303944e5d6c"],

