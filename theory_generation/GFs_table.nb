Cell["\<\
Here we express the ingoing/outgoing amplitude of the waves at infinity from \
the value of the solution and its derivative at infinity.\
\>", "Text",
 CellChangeTimes->{{3.5710771408231983`*^9, 3.5710771665108023`*^9}, {
  3.985858598586549*^9, 
  3.985858643802156*^9}},ExpressionUUID->"b904069e-b8bf-47a1-8670-\
bb18ad69e153"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Qinf", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"kk", "  ", "r"}]], 
        SuperscriptBox["r", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "s", " ", "\[Omega]"}], "-", 
           RowBox[{"2", " ", "M", " ", 
            SuperscriptBox["\[Omega]", "2"]}]}], "kk"]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"hhinf", "[", "i", "]"}], 
           SuperscriptBox["r", "i"]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"ORDINF", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "//.", 
      RowBox[{"Union", "[", 
       RowBox[{"systINF1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"hhinf", "[", "0", "]"}], "\[Rule]", "BB1"}], ",", 
          RowBox[{"kk", "\[Rule]", " ", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "\[Omega]"}]}]}], "}"}]}], "]"}]}], 
     ")"}], "+", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"kk", "  ", "r"}]], 
        SuperscriptBox["r", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "s", " ", "\[Omega]"}], "-", 
           RowBox[{"2", " ", "M", " ", 
            SuperscriptBox["\[Omega]", "2"]}]}], "kk"]], 
        RowBox[{"Sum", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"hhinf", "[", "i", "]"}], 
           SuperscriptBox["r", "i"]], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"ORDINF", "-", "1"}]}], "}"}]}], "]"}]}], ")"}], "//.", 
      RowBox[{"Union", "[", 
       RowBox[{"systINF1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"hhinf", "[", "0", "]"}], "\[Rule]", "CC1"}], ",", 
          RowBox[{"kk", "\[Rule]", 
           RowBox[{"I", " ", "\[Omega]"}]}]}], "}"}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Qpinf", "=", 
    RowBox[{"D", "[", 
     RowBox[{"Qinf", ",", "r"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solBC", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Qinf", "/.", 
           RowBox[{"r", "\[Rule]", "INF1"}]}], ")"}], "\[Equal]", "Y1"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Qpinf", "/.", 
           RowBox[{"r", "\[Rule]", "INF1"}]}], ")"}], "\[Equal]", "Y1p"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"BB1", ",", "CC1"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
