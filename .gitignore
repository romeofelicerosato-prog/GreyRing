# =========================
# GreyRing .gitignore
# =========================

# -------------------------
# Python cache / bytecode
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# -------------------------
# Build / packaging
# -------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -------------------------
# Virtual environments
# -------------------------
.env
.venv
env/
venv/
ENV/
*.conda/

# -------------------------
# Jupyter / notebooks
# -------------------------
.ipynb_checkpoints/

# -------------------------
# macOS / editor files
# -------------------------
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo
*~

# -------------------------
# Jekyll / GitHub Pages
# -------------------------
docs/_site/
docs/.sass-cache/
docs/.jekyll-cache/
docs/.jekyll-metadata
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# Output folders
# -------------------------
outdir/
outdirs/
output/
outputs/
results/
runs/
**/outdir/
**/outdirs/
**/output/
**/outputs/
**/results/
**/runs/

# -------------------------
# Bilby / sampler outputs
# -------------------------
*.hdf5
*.h5
*.pkl
*.pickle
*.npz
*.npy
*_result.json
*_resume.pickle
*_checkpoint*
dynesty*.pickle
bilby*.json

# -------------------------
# Plots generated by runs
# Keep docs/assets tracked, ignore plots elsewhere
# -------------------------
*.pdf
*.png
*.jpg
*.jpeg
*.gif
!docs/assets/**
!docs/assets/examples/**

# -------------------------
# Temporary / scratch files
# -------------------------
tmp/
temp/
scratch/
*.tmp
*.bak